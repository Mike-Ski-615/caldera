{
  "version": 1,
  "name": "Caldera Realistic",
  "budgetMiB": 1024,
  "textures": {
    "vanilla-clouds": {
      "source": "$minecraft/clouds",
      "filter": "nearest",
      "wrap": "repeat"
    }
  },
  "materials": {
    "minecraft:ice": 12,
    "minecraft:frosted_ice": 12,
    "minecraft:packed_ice": 13,
    "minecraft:blue_ice": 14,
    "minecraft:iron_block": 6,
    "minecraft:gold_block": 6,
    "minecraft:copper_block": 6,
    "minecraft:cut_copper": 6,
    "minecraft:netherite_block": 6,
    "minecraft:stone": 7,
    "minecraft:andesite": 7,
    "minecraft:granite": 7,
    "minecraft:diorite": 7,
    "minecraft:polished_andesite": 7,
    "minecraft:polished_granite": 7,
    "minecraft:polished_diorite": 7,
    "minecraft:oak_planks": 8,
    "minecraft:spruce_planks": 8,
    "minecraft:birch_planks": 8,
    "minecraft:jungle_planks": 8,
    "minecraft:acacia_planks": 8,
    "minecraft:dark_oak_planks": 8,
    "minecraft:mangrove_planks": 8,
    "minecraft:cherry_planks": 8,
    "minecraft:pale_oak_planks": 8,
    "minecraft:lava": 9,
    "minecraft:glowstone": 9,
    "minecraft:sea_lantern": 9,
    "minecraft:shroomlight": 9,
    "minecraft:redstone_lamp[lit=true]": 9,
    "minecraft:glow_lichen": 10,
    "minecraft:cave_vines[berries=true]": 10,
    "minecraft:cave_vines_plant[berries=true]": 10,
    "minecraft:redstone_ore[lit=true]": 11,
    "minecraft:deepslate_redstone_ore[lit=true]": 11,
    "minecraft:water": 1,
    "minecraft:short_grass": 2,
    "minecraft:fern": 2,
    "minecraft:tall_grass[half=lower]": 3,
    "minecraft:tall_grass[half=upper]": 4,
    "minecraft:large_fern[half=lower]": 3,
    "minecraft:large_fern[half=upper]": 4,
    "minecraft:oak_leaves": 5,
    "minecraft:birch_leaves": 5,
    "minecraft:spruce_leaves": 5,
    "minecraft:jungle_leaves": 5,
    "minecraft:acacia_leaves": 5,
    "minecraft:dark_oak_leaves": 5,
    "minecraft:mangrove_leaves": 5,
    "minecraft:cherry_leaves": 5,
    "minecraft:azalea_leaves": 5,
    "minecraft:flowering_azalea_leaves": 5,
    "minecraft:pale_oak_leaves": 5
  },
  "scenePrograms": [
    {
      "pipeline": "sodium:pipeline/solid_terrain",
      "vertex": "shaders/terrain.vsh",
      "fragment": "shaders/terrain.fsh",
      "textures": {
        "Opaque": "$terrainOpaque",
        "OpaqueDepth": "$terrainOpaqueDepth"
      },
      "writes": [
        "surface.data"
      ]
    },
    {
      "pipeline": "sodium:pipeline/cutout_terrain",
      "vertex": "shaders/terrain.vsh",
      "fragment": "shaders/terrain.fsh",
      "textures": {
        "Opaque": "$terrainOpaque",
        "OpaqueDepth": "$terrainOpaqueDepth"
      },
      "writes": [
        "surface.data"
      ]
    },
    {
      "pipeline": "sodium:pipeline/translucent_terrain",
      "vertex": "shaders/terrain.vsh",
      "fragment": "shaders/terrain.fsh",
      "textures": {
        "Opaque": "$terrainOpaque",
        "OpaqueDepth": "$terrainOpaqueDepth"
      },
      "writes": [
        "surface.data"
      ]
    }
  ],
  "options": {
    "ANTIALIASING": {
      "label": "Antialiasing",
      "default": 1,
      "values": [
        0,
        1
      ]
    },
    "COLOR_GRADE": {
      "label": "Color Style",
      "default": 0.5,
      "values": [
        0,
        0.25,
        0.5,
        1
      ]
    },
    "DISTANCE_COLOR": {
      "label": "Distance colors",
      "default": 1,
      "values": [
        0,
        0.5,
        1
      ]
    },
    "WET_SURFACES": {
      "label": "Rain-wet surfaces",
      "default": 0.5,
      "values": [
        0,
        0.25,
        0.5,
        0.75,
        1
      ]
    },
    "MATERIAL_SHEEN": {
      "label": "Material highlights",
      "default": 0.5,
      "values": [
        0,
        0.25,
        0.5,
        0.75,
        1
      ]
    },
    "EMISSIVE_ACCENTS": {
      "label": "Glowing blocks and plants",
      "default": 0.5,
      "values": [
        0,
        0.25,
        0.5,
        0.75,
        1
      ]
    },
    "VEGETATION_WIND": {
      "label": "Vegetation wind strength",
      "default": 1,
      "values": [
        0,
        0.5,
        1,
        1.5
      ]
    },
    "TM_EXPOSURE": {
      "label": "Exposure",
      "default": 1,
      "values": [
        0.6,
        0.8,
        1,
        1.2,
        1.4
      ]
    },
    "TM_CONTRAST": {
      "label": "Contrast",
      "default": 1.05,
      "values": [
        0.85,
        1,
        1.05,
        1.15,
        1.3
      ]
    },
    "T_SATURATION": {
      "label": "Saturation",
      "default": 1,
      "values": [
        0.8,
        0.9,
        1,
        1.1,
        1.2
      ]
    },
    "LIGHT_WARMTH": {
      "label": "Light warmth",
      "default": 1,
      "values": [
        0,
        0.5,
        1,
        1.5
      ]
    },
    "BLOOM_STRENGTH": {
      "label": "Bloom strength",
      "default": 0.12,
      "values": [
        0,
        0.06,
        0.12,
        0.2,
        0.3
      ]
    },
    "ATMOSPHERE": {
      "label": "Atmospheric haze",
      "default": 1,
      "values": [
        0,
        0.5,
        1,
        1.5,
        2
      ]
    },
    "WATER_ENABLED": {
      "label": "Water refraction",
      "default": 1,
      "values": [
        0,
        1
      ]
    },
    "WATER_WAVES": {
      "label": "Water waves",
      "default": 1,
      "values": [
        0,
        0.5,
        1,
        1.5
      ]
    },
    "WATER_DENSITY": {
      "label": "Water fog density",
      "default": 1,
      "values": [
        0.5,
        1,
        1.5,
        2
      ]
    },
    "SHADOW_QUALITY": {
      "label": "Shadow quality",
      "default": 2,
      "values": [
        0,
        1,
        2,
        3,
        4
      ]
    },
    "SHADOW_DISTANCE": {
      "label": "Shadow distance (blocks)",
      "default": 128,
      "values": [
        64,
        96,
        128,
        192,
        256
      ]
    },
    "CLOUD_QUALITY": {
      "label": "Cloud quality",
      "default": 2,
      "values": [
        0,
        1,
        2,
        3,
        4
      ]
    },
    "CLOUD_COVERAGE": {
      "label": "Cloud density (preserves vanilla shape)",
      "default": 0.5,
      "values": [
        0.25,
        0.5,
        0.75,
        1
      ]
    },
    "CLOUD_HEIGHT_OFFSET": {
      "label": "Cloud height offset from vanilla",
      "default": 0,
      "values": [
        -64,
        0,
        64
      ]
    },
    "SUN_SIZE": {
      "label": "Sun size",
      "default": 1,
      "values": [
        0.75,
        1,
        1.5
      ]
    },
    "SUN_SHAFTS": {
      "label": "Sun shafts",
      "default": 1,
      "values": [
        0,
        0.5,
        1,
        1.5,
        2
      ]
    },
    "AMBIENT_OCCLUSION": {
      "label": "Contact shading",
      "default": 1,
      "values": [
        0,
        0.5,
        1,
        1.5,
        2
      ]
    },
    "WATER_REFLECTION_QUALITY": {
      "label": "Water / ice reflection quality",
      "default": 2,
      "values": [
        0,
        1,
        2,
        3,
        4
      ]
    },
    "WATER_REFLECTION_STRENGTH": {
      "label": "Water / ice reflection strength",
      "default": 1,
      "values": [
        0,
        0.5,
        1
      ]
    },
    "HELD_LIGHTING": {
      "label": "Held-item light",
      "default": 1,
      "values": [
        0,
        0.5,
        1,
        1.5,
        2
      ]
    },
    "AUTO_EXPOSURE": {
      "label": "Auto exposure",
      "default": 1,
      "values": [
        0,
        1
      ]
    }
  },
  "resources": {
    "scene.hdr": {
      "format": "RGBA16_FLOAT"
    },
    "bloom.seed": {
      "format": "RGBA16_FLOAT",
      "scale": 0.5
    },
    "bloom.horizontal": {
      "format": "RGBA16_FLOAT",
      "scale": 0.5
    },
    "bloom.soft": {
      "format": "RGBA16_FLOAT",
      "scale": 0.5
    },
    "bloom.wide": {
      "format": "RGBA16_FLOAT",
      "scale": 0.125
    },
    "display": {
      "format": "RGBA8_UNORM"
    },
    "clouds.hdr": {
      "format": "RGBA16_FLOAT",
      "scale": 0.5
    },
    "clouds.distance": {
      "format": "R32_FLOAT",
      "scale": 0.5
    },
    "lighting.half": {
      "format": "RG16_FLOAT",
      "scale": 0.5
    },
    "surface.data": {
      "format": "RG32_UINT"
    },
    "water.reflection": {
      "format": "RGBA16_FLOAT",
      "scale": 1
    },
    "exposure.meter": {
      "format": "RG32_FLOAT",
      "size": [
        32,
        18,
        1
      ]
    },
    "exposure.adapted": {
      "format": "R32_FLOAT",
      "size": [
        1,
        1,
        1
      ],
      "history": true
    }
  },
  "passes": [
    {
      "name": "clouds",
      "fragment": "shaders/clouds.fsh",
      "reads": {
        "Depth": "$depth",
        "VanillaClouds": "$texture/vanilla-clouds"
      },
      "writes": [
        "clouds.hdr",
        "clouds.distance"
      ]
    },
    {
      "name": "lighting",
      "fragment": "shaders/lighting.fsh",
      "reads": {
        "Depth": "$depth",
        "VanillaClouds": "$texture/vanilla-clouds"
      },
      "writes": [
        "lighting.half"
      ]
    },
    {
      "name": "water-reflections",
      "fragment": "shaders/water-reflections.fsh",
      "reads": {
        "Surface": "surface.data",
        "Depth": "$depth",
        "HandDepth": "$handDepth",
        "Opaque": "$terrainOpaque",
        "OpaqueDepth": "$terrainOpaqueDepth",
        "Scene": "$scene",
        "VanillaClouds": "$texture/vanilla-clouds"
      },
      "writes": [
        "water.reflection"
      ]
    },
    {
      "name": "atmosphere",
      "fragment": "shaders/atmosphere.fsh",
      "reads": {
        "Scene": "$scene",
        "Weather": "$weather",
        "Depth": "$depth",
        "HandDepth": "$handDepth",
        "Clouds": "clouds.hdr",
        "CloudDistance": "clouds.distance",
        "Lighting": "lighting.half",
        "Surface": "surface.data",
        "WaterReflection": "water.reflection"
      },
      "writes": [
        "scene.hdr"
      ],
      "readConditions": {
        "Clouds": [
          "CLOUD_QUALITY"
        ],
        "CloudDistance": [
          "CLOUD_QUALITY"
        ],
        "Lighting": [
          "AMBIENT_OCCLUSION",
          "SUN_SHAFTS"
        ],
        "WaterReflection": [
          [
            "WATER_ENABLED",
            "WATER_REFLECTION_QUALITY",
            "WATER_REFLECTION_STRENGTH"
          ]
        ]
      }
    },
    {
      "name": "bloom-seed",
      "fragment": "shaders/bloom-seed.fsh",
      "reads": {
        "Source": "scene.hdr"
      },
      "writes": [
        "bloom.seed"
      ],
      "linearReads": [
        "Source"
      ]
    },
    {
      "name": "bloom-horizontal",
      "fragment": "shaders/blur-x.fsh",
      "reads": {
        "Source": "bloom.seed"
      },
      "writes": [
        "bloom.horizontal"
      ],
      "linearReads": [
        "Source"
      ]
    },
    {
      "name": "bloom-soft",
      "fragment": "shaders/blur-y.fsh",
      "reads": {
        "Source": "bloom.horizontal"
      },
      "writes": [
        "bloom.soft"
      ],
      "linearReads": [
        "Source"
      ]
    },
    {
      "name": "bloom-wide",
      "fragment": "shaders/bloom-wide.fsh",
      "reads": {
        "Source": "bloom.soft"
      },
      "writes": [
        "bloom.wide"
      ],
      "linearReads": [
        "Source"
      ]
    },
    {
      "name": "exposure-meter",
      "fragment": "shaders/exposure-meter.fsh",
      "reads": {
        "Source": "scene.hdr",
        "Depth": "$depth",
        "HandDepth": "$handDepth"
      },
      "writes": [
        "exposure.meter"
      ]
    },
    {
      "name": "exposure-adapt",
      "fragment": "shaders/exposure-adapt.fsh",
      "reads": {
        "Meter": "exposure.meter",
        "Previous": "exposure.adapted@previous"
      },
      "writes": [
        "exposure.adapted"
      ]
    },
    {
      "name": "final",
      "fragment": "shaders/final.fsh",
      "reads": {
        "Source": "scene.hdr",
        "Bloom": "bloom.soft",
        "Wide": "bloom.wide",
        "Exposure": "exposure.adapted"
      },
      "writes": [
        "display"
      ],
      "linearReads": [
        "Source",
        "Bloom",
        "Wide"
      ],
      "readConditions": {
        "Bloom": [
          "BLOOM_STRENGTH"
        ],
        "Wide": [
          "BLOOM_STRENGTH"
        ],
        "Exposure": [
          "AUTO_EXPOSURE"
        ]
      }
    }
  ],
  "present": "display",
  "shadows": true,
  "environment": {
    "sky": true,
    "clouds": true
  },
  "sceneTargets": [
    "surface.data"
  ]
}
